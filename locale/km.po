msgctxt "field:account.move,company:"
msgid "Company"
msgstr "ក្រុមហ៊ុន"

msgctxt "field:account.move.renumber.start,first_number:"
msgid "First Number"
msgstr "លេខដំបូង"

msgctxt "field:account.move.renumber.start,fiscalyear:"
msgid "Fiscal Year"
msgstr "ឆ្នាំសារពើពន្ធ"

msgctxt "model:account.move.renumber.start,string:"
msgid "Account Move Renumber Start"
msgstr "ចាប់ផ្ដើមដាក់លេខកំណត់ត្រាគណនេយ្យឡើងវិញ"

msgctxt "model:ir.action,name:wizard_move_renumber"
msgid "Renumber Moves"
msgstr "ដាក់លេខកំណត់ត្រាគណនេយ្យឡើងវិញ"

#, python-format
msgctxt "model:ir.message,text:draft_moves_in_fiscalyear"
msgid "There are Draft Moves in Fiscal Year \"%(fiscalyear)s\"."
msgstr "មានកំណត់ត្រាគណនេយ្យជាសេចក្តីព្រាងក្នុងឆ្នាំសារពើពន្ធ «%(fiscalyear)s»។"

msgctxt "model:ir.ui.menu,name:menu_move_renumber"
msgid "Renumber Moves"
msgstr "ដាក់លេខកំណត់ត្រាគណនេយ្យឡើងវិញ"

msgctxt "view:account.move.renumber.start:"
msgid ""
"This process will take a few minutes. Please, ensure that nobody create or "
"confirm moves for selected fiscal year."
msgstr ""
"ដំណើរការនេះចំណាយពេលពីរបីនាទី។ សូមប្រាកដថាគ្មាននរណាបង្កើត "
"ឬបញ្ជាក់កំណត់ត្រាគណនេយ្យក្នុងឆ្នាំសារពើពន្ធដែលបានជ្រើសរើស។"

msgctxt "wizard_button:account.move.renumber,start,end:"
msgid "Cancel"
msgstr "បោះបង់"

msgctxt "wizard_button:account.move.renumber,start,renumber:"
msgid "Renumber"
msgstr "ដាក់លេខឡើងវិញ"

msgctxt "model:account.move.renumber.start,name:"
msgid "Renumber Account Moves Start"
msgstr "ចាប់ផ្ដើមដាក់លេខកំណត់ត្រាគណនេយ្យឡើងវិញ"
